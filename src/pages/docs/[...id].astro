---
import { type CollectionEntry, render } from 'astro:content'

import { MediumZoom } from 'astro-pure/advanced'
import { TOC } from 'astro-pure/components/pages'
import { getBlogCollection } from 'astro-pure/server'
import { Comment } from '@/components/comments'
import DocsContents from '@/components/docs/DocsContents.astro'
import PageLayout from '@/layouts/ContentLayout.astro'

export const prerender = true

export async function getStaticPaths() {
  const posts = await getBlogCollection('docs')
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post }
  }))
}

type Props = {
  post: CollectionEntry<'docs'>
}

const { post } = Astro.props as Props
const { Content, headings } = await render(post)
const { description, title } = post.data

const collectionId = post.id.split('/')[0]
const allDocs = (await getBlogCollection('docs')) as CollectionEntry<'docs'>[]
const collectionDocs = allDocs
  .filter((doc) => doc.id.split('/')[0] === collectionId)
  .sort((a, b) => a.data.order - b.data.order)
const currentIndex = collectionDocs.findIndex((doc) => doc.id === post.id)
const previousDoc = currentIndex > 0 ? collectionDocs[currentIndex - 1] : undefined
const nextDoc = currentIndex >= 0 ? collectionDocs[currentIndex + 1] : undefined

---

<PageLayout meta={{ description, title }} back='/docs'>
  <Fragment slot='sidebar'>
    {!!headings.length && <TOC {headings} />}
    <DocsContents class='docs-toc block mt-3' />
  </Fragment>

  <Fragment slot='header'>
    <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl'>
      {title}
    </h1>
    <div class='mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs leading-6 text-muted-foreground'>
      {
        // Description
        description && (
          <blockquote class='text-sm italic text-muted-foreground'>
            <q>{description}</q>
          </blockquote>
        )
      }
    </div>
    {

        /* Show more docs collapse on small screen */
        // <Collapse class='md:hidden' title='See more docs'>
        //   <DocsContents title={false} />
        // </Collapse>
    }
  </Fragment>

  <Content />

  <div slot='bottom'>
    <nav class='docs-pagination' aria-label='Document navigation'>
      {
        previousDoc && (
          <a class='docs-page-card docs-page-previous' href={`/docs/${previousDoc.id}`} rel='prev'>
            <span>Previous</span>
            <strong>{previousDoc.data.title}</strong>
          </a>
        )
      }
      {
        nextDoc && (
          <a class='docs-page-card docs-page-next' href={`/docs/${nextDoc.id}`} rel='next'>
            <span>Next</span>
            <strong>{nextDoc.data.title}</strong>
          </a>
        )
      }
    </nav>
    <Comment class='mt-6 sm:mt-10' />
  </div>
</PageLayout>
<MediumZoom />

<style>
  .docs-pagination {
    display: grid;
    width: 100%;
    max-width: 48rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.75rem;
  }

  .docs-page-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.3rem;
    border: 1px solid hsl(var(--border) / var(--un-border-opacity, 1));
    border-radius: 0.9rem;
    background: hsl(var(--background) / var(--un-bg-opacity, 1));
    padding: 0.9rem 1rem;
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .docs-page-card:hover {
    border-color: hsl(var(--primary) / 0.35);
    background: hsl(var(--muted) / var(--un-bg-opacity, 1));
  }

  .docs-page-card span {
    color: hsl(var(--muted-foreground) / var(--un-text-opacity, 1));
    font-size: 0.75rem;
  }

  .docs-page-card strong {
    overflow-wrap: anywhere;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .docs-page-next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 639px) {
    .docs-pagination {
      grid-template-columns: minmax(0, 1fr);
    }

    .docs-page-next {
      grid-column: 1;
    }
  }

  .docs-toc {
    width: 100%;
    max-width: 15rem;
  }

  .docs-toc :global(.docs-item a) {
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.35;
  }

  @media (min-width: 1300px) {
    :global(
      main, .bottom { transform: translateX(7.9rem); }
      #sidebar { overflow: inherit; }
      toc-heading { height: 100%; display: flex; flex-direction: column; }
      toc-heading > ul { overflow-y: scroll; }
    )
    .docs-toc {
      position: fixed;
      top: 0;
      left: -64rem;
      margin-top: 0;
      max-height: calc(100vh - 7rem);
      overflow-y: scroll;
      padding-right: 1rem !important;
      width: 15rem;
      max-width: 15rem;
    }
  }
</style>
