---
import { Icon } from 'astro-pure/user'
import avatar from '@/assets/avator.jpg'
import config from '@/site-config'
---

<header-component
  class='group sticky top-4 z-50 mb-12 flex items-center justify-between rounded-xl border border-transparent max-md:z-30 max-sm:py-1 sm:rounded-2xl'
>
  <a
    class='brand z-30 flex items-center gap-2 text-xl font-medium group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href='/'
    aria-label='Home'
  >
    <img
      src={avatar.src}
      width={avatar.width}
      height={avatar.height}
      alt=''
      class='brand-avatar'
      aria-hidden='true'
    />
    <span>{config.title}</span>
  </a>

  <div class='flex items-center gap-x-2'>
    <div
      id='headerExpandContent'
      class='end-0 start-0 top-12 grid border border-transparent group-[.not-top]:rounded-xl group-[.expanded]:opacity-100 dark:group-[.expanded.not-top]:bg-muted max-sm:absolute max-sm:opacity-0 max-sm:group-[.not-top]:border-border max-sm:group-[.expanded.not-top]:bg-background max-sm:group-[.not-top]:px-4 max-sm:group-[.not-top]:py-2 sm:grid-rows-1'
    >
      <div class='flex flex-col items-center justify-center overflow-hidden sm:flex-row'>
        {
          config.header.menu?.map((item) => (
            <a
              href={item.link}
              class='w-full flex-none grow py-2 text-right font-medium transition-none hover:text-primary sm:w-fit sm:px-3'
              aria-label='Nav menu item'
              data-astro-prefetch
            >
              {item.title}
            </a>
          ))
        }
        <div class='flex w-full grow flex-row justify-end gap-x-3 sm:w-fit sm:gap-x-5'>
          <a class='px-1 py-2 transition-none sm:px-2' href='/search' title='Search'>
            <span class='sr-only'>Search</span>
            <Icon name='search' class='size-5' />
          </a>
        </div>
      </div>
    </div>

    <div class='z-30 flex gap-x-4 group-[.not-top]:gap-x-2' style='transition:gap 0.3s'>
      <button
        id='toggleDarkMode'
        class='group/dark box-content size-5 rounded-md border p-1.5 transition-colors hover:bg-border sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Dark Theme</span>
        <Icon class='system size-5 group-hover/dark:text-primary' name='computer' />
        <Icon class='light hidden size-5 group-hover/dark:text-primary' name='sun' />
        <Icon class='dark hidden size-5 group-hover/dark:text-primary' name='moon' />
      </button>
      <button
        id='toggleMenu'
        class='rounded-md border p-1.5 transition-colors hover:bg-border sm:hidden sm:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only'>Menu</span>
        <Icon class='size-5' name='menu' />
      </button>
    </div>
  </div>
</header-component>

<script is:inline>
  function setHeaderTheme(theme, save = false) {
    const themes = ['system', 'dark', 'light']
    if (!theme) {
      theme = localStorage.getItem('theme') || 'system'
      if (save) {
        theme = themes[(themes.indexOf(theme) + 1) % themes.length]
      }
    }
    if (save) localStorage.setItem('theme', theme)

    const targetTheme = theme === 'system'
      ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      : theme
    document.documentElement.classList.toggle('dark', targetTheme === 'dark')
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      'content',
      targetTheme === 'dark' ? '#0B0B10' : '#FCFCFD'
    )
    return theme
  }

  function initializeHeader(header) {
    if (header.dataset.initialized === 'true') return
    header.dataset.initialized = 'true'

    let preScrollY = window.scrollY
    header.classList.toggle('not-top', preScrollY > 20)
    window.addEventListener('scroll', () => {
      header.classList.toggle('not-top', window.scrollY > 20)
      header.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
      preScrollY = window.scrollY
    }, { passive: true })

    const darkModeBtn = header.querySelector('#toggleDarkMode')
    if (darkModeBtn) darkModeBtn.dataset.theme = localStorage.getItem('theme') || 'system'
    darkModeBtn?.addEventListener('click', () => {
      const newTheme = setHeaderTheme(undefined, true)
      darkModeBtn.dataset.theme = newTheme
      document.dispatchEvent(new CustomEvent('toast', {
        detail: { message: `Set theme to ${newTheme}` }
      }))
    })

    header.querySelector('#toggleMenu')?.addEventListener('click', () => {
      header.classList.toggle('expanded')
    })
  }

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      initializeHeader(this)
    }
  }

  if (!customElements.get('header-component')) {
    customElements.define('header-component', HeaderComponent)
  }
  document.querySelectorAll('header-component').forEach(initializeHeader)
</script>

<style>
  .brand-avatar {
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 999px;
    object-fit: cover;
  }

  header-component {
    transition: padding 0.3s, transform 0.3s, margin-inline 0.3s, border 0.15s, background-color 0.15s;

    &.not-top {
      --un-border-opacity: 1;
      border-color: hsl(var(--border) / var(--un-border-opacity));
      --un-bg-opacity: 1;
      background-color: hsl(var(--background) / var(--un-bg-opacity));
      padding-left: 0.375rem;
      padding-right: 0.375rem;
      box-shadow: rgb(255, 255, 255) 0 0 0 0, rgba(24, 24, 27, 0.08) 0 0 0 1px, rgba(39, 39, 42, 0.08) 0 10px 15px -3px, rgba(39, 39, 42, 0.08) 0 4px 6px -4px;
    }

    &[data-show='false']:not(.expanded) { transform: translateY(-5rem); }
  }

  @media (min-width: 800px) { header-component.not-top { margin-inline: 8%; } }
  :global(.dark) header-component.not-top { background-color: hsl(var(--muted) / var(--un-bg-opacity)); }

  @media (max-width: 640px) {
    .brand { gap: 0.45rem; font-size: 1rem; }
    .brand-avatar { width: 1.7rem; height: 1.7rem; }
    #headerExpandContent { grid-template-rows: 0fr; transition: opacity 0.3s, padding 0.3s, border-color 0.15s, grid-template-rows 0.3s; }
    .expanded #headerExpandContent { grid-template-rows: 1fr; }
    .expanded.not-top #headerExpandContent { box-shadow: rgb(255, 255, 255) 0 0 0 0, rgba(24, 24, 27, 0.08) 0 0 0 1px, rgba(39, 39, 42, 0.08) 0 10px 15px -3px, rgba(39, 39, 42, 0.08) 0 4px 6px -4px; }
    header-component #headerExpandContent::after { box-sizing: content-box; content: ''; position: absolute; inset-inline: calc(-1rem - 1px); bottom: 0; top: -5rem; z-index: -1; transition: 0.3s; visibility: hidden; opacity: 0; border-bottom: 1px solid transparent; }
    header-component:not(.not-top) #headerExpandContent::after { visibility: visible; bottom: -1rem; opacity: 1; background-color: hsl(var(--muted) / var(--un-bg-opacity, 1)); border-bottom-color: hsl(var(--border) / var(--un-border-opacity, 1)); }
  }

  #toggleDarkMode {
    &[data-theme='dark'] { & .system { display: none; } & .dark { display: block; } }
    &[data-theme='light'] { & .system { display: none; } .light { display: block; } }
  }
</style>
